# Normalize line endings to LF in the repository.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of diffs and language stats
pnpm-lock.yaml linguist-generated=true -diff
uv.lock        linguist-generated=true -diff
