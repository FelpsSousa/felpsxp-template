# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[{Makefile,*.mk,go.mod,go.sum,*.go}]
indent_style = tab
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
